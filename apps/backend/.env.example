# Database (PostgreSQL 16 matching docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clickon_db

# Cache & Rate Limiting (Redis 7 matching docker-compose.yml - Optional, falls back to memory/DB if unavailable)
REDIS_URL=redis://localhost:6379

# JWT Authentication
# In production, both secrets MUST be at least 32 characters long and have NO defaults
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Application URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Email Delivery: Resend (preferred if key is provided)
RESEND_API_KEY=

# Email Delivery: SMTP (fallback if Resend is unset; dev logs to console if both unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Contact Form Delivery Settings
CONTACT_EMAIL_TO=support@clickon.io
CONTACT_EMAIL_FROM=noreply@clickon.io
